{
  "manifest_version": 3,
  "name": "知了 Reelize（视频更新速递）",
  "version": "1.4.0",
  "description": "知了 Reelize：视频更新自动总结速递——监控 B 站/抖音更新，模型总结与速评，邮件送达",
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "scripting",
    "unlimitedStorage",
    "clipboardWrite",
    "history"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "知了 Reelize"
  },
  "minimum_chrome_version": "120",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; img-src 'self' data:;"
  },
  "options_page": "keydock/options.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "daylog/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}